<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.jnf.harness</groupId>
    <artifactId>jnf-harness</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>jnf-harness-plugin-subagent</artifactId>
  <name>jnf-harness-plugin-subagent</name>
  <description>默认子智能体插件（P8-3）：delegate_task 把独立子任务派发给子智能体执行（独立会话/独立预算；宿主 spi.host.AgentRunService 治理深度与超时）</description>

  <dependencies>
    <!-- 插件只依赖 SDK（jnf-harness-types），provided：宿主提供运行时，不打进插件 JAR -->
    <dependency>
      <groupId>com.jnf.harness</groupId>
      <artifactId>jnf-harness-types</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
