<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.jnf.harness</groupId>
  <artifactId>jnf-harness</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>jnf-harness</name>
  <description>jnf 的自有 Agent Harness：DDD 六边形 + ReAct 循环 + 会话事件溯源 + 插件体系</description>

  <developers>
    <developer>
      <name>jnf</name>
    </developer>
  </developers>

  <modules>
    <module>jnf-harness-types</module>
    <module>jnf-harness-api</module>
    <module>jnf-harness-case</module>
    <module>jnf-harness-domain</module>
    <module>jnf-harness-infrastructure</module>
    <module>jnf-harness-trigger</module>
    <module>jnf-harness-sample-plugin</module>
    <module>jnf-harness-plugin-fs</module>
    <module>jnf-harness-plugin-shell</module>
    <module>jnf-harness-plugin-web</module>
    <module>jnf-harness-plugin-essentials</module>
    <module>jnf-harness-app</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <spring-boot.version>3.3.5</spring-boot.version>
    <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
    <archunit.version>1.3.0</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 内部模块 -->
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-types</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-case</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-trigger</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- 官方插件（P2：内核零内置工具；独立 JAR 交付，provided 不进 fat jar） -->
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-plugin-fs</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-plugin-shell</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-plugin-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-plugin-essentials</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jnf.harness</groupId>
        <artifactId>jnf-harness-sample-plugin</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis-spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <encoding>${project.build.sourceEncoding}</encoding>
            <!-- Spring @PathVariable/@RequestParam 参数名解析依赖 -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
