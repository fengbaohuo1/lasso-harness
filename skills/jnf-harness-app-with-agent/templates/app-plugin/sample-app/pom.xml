<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.appplugin</groupId>
    <artifactId>app-plugin-template</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>sample-app</artifactId>
  <name>sample-app</name>
  <description>业务应用：REST + 静态页 + /api/assistant/stream 代理底座 Agent（浏览器不碰 API Key）</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- 固定产物名：target/sample-app.jar（换项目名时同步改，安装脚本按这个名字接收 jar） -->
    <finalName>sample-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
